{
    "name": "VibeSpace - Live App",
    "image": "python:3.12-slim",
    "postCreateCommand": "pip install --no-cache-dir -r requirements.txt",
    "postStartCommand": "bash -lc 'if [ ! -f /tmp/vs_started ]; then touch /tmp/vs_started; nohup python server.py --host 0.0.0.0 --port 5566 > /tmp/vibespace.log 2>&1 & fi'",
    "forwardPorts": [5566],
    "portsAttributes": {
        "5566": {
            "label": "VibeSpace",
            "visibility": "public",
            "onAutoForward": "notify"
        }
    },
    "customizations": {
        "codespaces": {
            "repositories": {
                "rushikeshgajananshinde993-lab/VibeSpace": {
                    "permissions": {
                        "contents": "read"
                    }
                }
            }
        }
    }
}